# Geliştirme ortamı için örnek .env
# Üretimde SECRET_KEY mutlaka değiştirilmeli!
# Bu dosyayı .gitignore'a ekle, .env.example olarak paylaş

APP_NAME=QLink
DEBUG=false

# JWT
SECRET_KEY=changeme-use-openssl-rand-hex-32-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (docker-compose servis adıyla)
DATABASE_URL=postgresql://qlink:qlink@postgres:5432/qlink

# LocalStack S3
AWS_ENDPOINT_URL=http://localstack:4566
AWS_BUCKET_NAME=qlink-qrcodes
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# OpenTelemetry (Bonus) - varsayılan olarak kapalı
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=qlink-backend
